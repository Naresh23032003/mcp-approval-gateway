{
  "name": "mcp-approval-gateway",
  "version": "0.1.0",
  "description": "Self-hosted OAuth 2.1 server and MCP approval gateway",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "mcp-approval-gateway": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"const fs=require('node:fs');fs.cpSync('src/store/migrations','dist/store/migrations',{recursive:true})\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^12.11.1",
    "express": "^5.3.0",
    "smol-toml": "^1.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "eslint": "^9.21.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.25.0",
    "vitest": "^4.1.12"
  }
}
